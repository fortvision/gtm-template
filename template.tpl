___TESTS___

scenarios:
- name: Loads the correct site tag
  code: |
    let capturedUrl;
    let capturedToken;
    mock('injectScript', function(url, onSuccess, onFailure, token) {
      capturedUrl = url;
      capturedToken = token;
      onSuccess();
    });
    runCode({siteId: 'ls_example_123'});
    assertThat(capturedUrl).isEqualTo('https://app.fortvision.com/api/onsite?js=1&pub=ls_example_123');
    assertThat(capturedToken).isEqualTo('fortvision-ls_example_123');
    assertApi('gtmOnSuccess').wasCalled();
- name: Rejects missing site ID
  code: |-
    mock('injectScript', function() { fail('Unexpected script load'); });
    runCode({siteId: ''});
    assertApi('injectScript').wasNotCalled();
    assertApi('gtmOnFailure').wasCalled();


