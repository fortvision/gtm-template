___SANDBOXED_JS_FOR_WEB_TEMPLATE___

const injectScript = require('injectScript');
const encodeUriComponent = require('encodeUriComponent');

const siteId = data.siteId;
if (!siteId) {
  data.gtmOnFailure();
  return;
}

const scriptUrl = 'https://app.fortvision.com/api/onsite?js=1&pub=' + encodeUriComponent(siteId);
injectScript(scriptUrl, data.gtmOnSuccess, data.gtmOnFailure, 'fortvision-' + siteId);


